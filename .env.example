# Copy to .env for local development. Every value is read by the Python backend
# (backend/app/config.py); nothing here is ever sent to the browser.

# GEMINI_API_KEY: enables the Gemini copilots. Leave empty to run without a model -
# every AI endpoint then answers with a clearly marked deterministic fallback.
# Never commit a real key; on a host, set it in the platform's secret store.
GEMINI_API_KEY=""

# GEMINI_TIMEOUT_SECONDS: upper bound on one Gemini call (never retried). Default 120.
# GEMINI_TIMEOUT_SECONDS="120"

# SESSION_SECRET: signs the session cookie. Set a long random string anywhere other
# than your own machine; without it the server uses an insecure development default
# and logs a warning.
SESSION_SECRET=""

# DEMO_MODE: when "true", a bare user id signs in with no password. A full
# authentication bypass - for trusted demos only, never with real employee data.
DEMO_MODE="false"

# DATABASE_PATH: the SQLite file. Defaults to capability-hub.db in the working
# directory; point it at a persistent volume on hosts with an ephemeral disk.
# DATABASE_PATH="capability-hub.db"

# PORT: port to listen on. Default 8000. Most hosts inject it.
# PORT="8000"

# APP_URL: the public https:// URL of a deployment. Marks the deploy as HTTPS, which
# makes the session cookie Secure. Leave empty for local development over http.
APP_URL=""

# COOKIE_SAMESITE: lax | strict | none. Defaults to none on HTTPS (works inside an
# iframe), lax otherwise. A standalone HTTPS deployment should set lax.
# COOKIE_SAMESITE="lax"

# AUTH_RATE_LIMIT_MAX: sign-in attempts per client address per 15 minutes. Default 30.
# AUTH_RATE_LIMIT_MAX="30"

# TRUST_PROXY: read the client address from X-Forwarded-For. Default true; set false
# when the app is reachable directly, so a client cannot choose its own rate-limit key.
# TRUST_PROXY="true"
