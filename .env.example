# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Signs the login session cookie. Set this to a long random string.
# Without it, the server falls back to an insecure development default - fine for local
# testing, not fine for anything reachable beyond your own machine.
SESSION_SECRET="MY_SESSION_SECRET"

# DEMO_MODE: When "true", allows logging in with just a userId (no password) and enables
# the in-app role switcher for ANY account with no credential check. Off by default.
# Only enable this for trusted demo/pilot audiences - never for a real deployment with
# real employee data.
DEMO_MODE="false"

