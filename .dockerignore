# Keep the build context small and secrets out of the image.
**/node_modules
**/dist
.git
.gitignore

# Secrets and local state
.env
.env.*
!.env.example
capability-hub.db
capability-hub.db-journal
capability-hub.db-wal
capability-hub.db-shm
backups
sample-data
cookie.txt

# Python: the local virtualenv and bytecode never belong in the image. The image
# installs backend/requirements.txt itself and copies only backend/app, seed and
# scripts (see Dockerfile).
backend/.venv
backend/tests
**/__pycache__
**/*.pyc

# Build artifacts and tooling
cybridge-changes-*.zip
cybridge-python-backend.zip
*.log
.claude
.vscode
