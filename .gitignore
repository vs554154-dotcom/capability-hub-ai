node_modules/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Python backend
backend/.venv/
__pycache__/
*.pyc

# Local database. Derived: the backend builds the schema (backend/app/migrations.py)
# and seeds it (backend/seed/seed.json) on boot. Also accumulates bcrypt password
# hashes and sessions as accounts are used, which do not belong in version control.
capability-hub.db
capability-hub.db-journal
capability-hub.db-wal
capability-hub.db-shm

# Captured session cookie from local curl testing - a live credential.
cookie.txt

# Port bundles: build artifacts, regenerated on demand.
cybridge-changes-*.zip
cybridge-python-backend.zip

# Claude Code per-machine settings (permission allowlists). launch.json is shared
# project config and stays tracked; settings.local.json is local by design.
.claude/settings.local.json

# Copies of the database made before a data load: they hold password hashes too.
backups/
